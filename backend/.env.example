# --- Database ---
# Production / hosted: a single connection string overrides the rest.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Local fallback (used when DATABASE_URL is unset).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=biblioteca_personal

# --- Auth ---
# Secret used to sign JWTs. Generate with: openssl rand -hex 64
JWT_SECRET=043NwoOzJSIovC1J0fa1IBjM5sbX4JVM4Y8DtpCgfYP
JWT_EXPIRES_IN=7d

# --- Server ---
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000